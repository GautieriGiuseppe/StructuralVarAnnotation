#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SAMPLES=""
OUTDIR=""
CONFIG="$REPO_DIR/config.yml"
JOBS=100
DRYRUN=0
SLURM=0
CLUSTER_JOBS=0
PARTITION="cpuq"

usage() {
    cat <<EOF
StructuralVarAnnotation

Usage:
  StructuralVarAnnotation.sh --samples samples.tsv --outdir results/run_name [options]

Required:
  --samples FILE        Sample TSV with sample_id, ubam, summary, fastq, batch_id
  --outdir DIR          Output directory

Options:
  --config FILE         Config YAML [default: repo config.yml]
  --jobs N              Number of Snakemake jobs [default: 100]
  --slurm               Submit the Snakemake controller with sbatch
  --cluster-jobs        Internal/developer option: submit workflow rules with sbatch
  --partition NAME      SLURM partition [default: cpu]
  --dry-run             Dry run only
  --help                Show this help

Examples:
  Direct/local Snakemake:
    bin/StructuralVarAnnotation.sh --samples samples.tsv --outdir results/test_run

  Submit full controller to SLURM and submit workflow rules as SLURM jobs:
    bin/StructuralVarAnnotation.sh --samples samples.tsv --outdir results/test_run --slurm --jobs 200

  Run controller in current shell but submit workflow rules to SLURM:
    bin/StructuralVarAnnotation.sh --samples samples.tsv --outdir results/test_run --cluster-jobs --jobs 200
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --samples)
            SAMPLES="$2"
            shift 2
            ;;
        --outdir)
            OUTDIR="$2"
            shift 2
            ;;
        --config)
            CONFIG="$2"
            shift 2
            ;;
        --jobs)
            JOBS="$2"
            shift 2
            ;;
        --slurm)
            SLURM=1
            shift
            ;;
        --cluster-jobs)
            CLUSTER_JOBS=1
            shift
            ;;
        --partition)
            PARTITION="$2"
            shift 2
            ;;
        --dry-run)
            DRYRUN=1
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            usage
            exit 1
            ;;
    esac
done

if [[ -z "$SAMPLES" ]]; then
    echo "ERROR: --samples is required" >&2
    usage
    exit 1
fi

if [[ -z "$OUTDIR" ]]; then
    echo "ERROR: --outdir is required" >&2
    usage
    exit 1
fi

if [[ ! -f "$SAMPLES" ]]; then
    echo "ERROR: samples file not found: $SAMPLES" >&2
    exit 1
fi

if [[ ! -f "$CONFIG" ]]; then
    echo "ERROR: config file not found: $CONFIG" >&2
    exit 1
fi

mkdir -p "$OUTDIR" "$OUTDIR/logs" "$REPO_DIR/logs"

# ---------------------------------------------------------------------
# Submit controller job to SLURM
# ---------------------------------------------------------------------
if [[ "$SLURM" -eq 1 ]]; then
    export SVA_REPO_DIR="$REPO_DIR"
    export SVA_SAMPLES="$SAMPLES"
    export SVA_CONFIG="$CONFIG"
    export SVA_OUTDIR="$OUTDIR"
    export SVA_JOBS="$JOBS"
    export SVA_PARTITION="$PARTITION"

    echo "Submitting StructuralVarAnnotation controller to SLURM:"
    echo "  samples:   $SVA_SAMPLES"
    echo "  config:    $SVA_CONFIG"
    echo "  outdir:    $SVA_OUTDIR"
    echo "  jobs:      $SVA_JOBS"
    echo "  partition: $SVA_PARTITION"
    echo

    sbatch "$REPO_DIR/run_workflow.sh"
    exit 0
fi

# ---------------------------------------------------------------------
# Run Snakemake controller directly
# ---------------------------------------------------------------------
CMD=(
    snakemake
    -s "$REPO_DIR/workflow_master.smk"
    --configfile "$CONFIG"
    --config
        "samples=$SAMPLES"
        "output=$OUTDIR"
    --use-conda
    --conda-frontend mamba
    --rerun-incomplete
    --latency-wait 120
    --printshellcmds
    --jobs "$JOBS"
)

if [[ "$CLUSTER_JOBS" -eq 1 ]]; then
    CMD+=(
        --cluster
        "sbatch --partition=${PARTITION} --cpus-per-task={threads} --mem={resources.mem_mb}M --time={resources.time} --output=${OUTDIR}/logs/%x_%j.out --error=${OUTDIR}/logs/%x_%j.err"
    )
fi

if [[ "$DRYRUN" -eq 1 ]]; then
    CMD+=(-n)
fi

echo "Repository:   $REPO_DIR"
echo "Samples:      $SAMPLES"
echo "Config:       $CONFIG"
echo "Output:       $OUTDIR"
echo "Jobs:         $JOBS"
echo "Cluster jobs: $CLUSTER_JOBS"
echo

echo "Running:"
printf ' %q' "${CMD[@]}"
echo
echo

"${CMD[@]}"